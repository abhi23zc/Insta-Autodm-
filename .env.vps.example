# Generate .env.vps with: node scripts/configure-vps.mjs dm.example.com you@example.com
APP_DOMAIN=dm.example.com
WEB_PORT=3107
NEXTAUTH_URL=https://dm.example.com
NEXTAUTH_SECRET=GENERATE_ME
CRON_SECRET=GENERATE_ME
ENCRYPTION_KEY=GENERATE_ME
POSTGRES_PASSWORD=GENERATE_ME

# Gmail SMTP. Replace APP_PASSWORD with a Google App Password without spaces.
# URL-encode special characters in SMTP usernames and passwords.
EMAIL_SERVER=smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
EMAIL_FROM="OpenReply <you@gmail.com>"
ALLOWED_EMAILS=you@example.com

# Optional direct Meta connection. Zernio keys are saved in the dashboard.
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=GENERATE_ME
